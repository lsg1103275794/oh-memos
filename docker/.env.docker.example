# ============================================================================
# oh-memos Docker 部署配置示例
# ============================================================================
# 用法:
#   cp docker/.env.docker.example docker/.env.docker
#   # 编辑 docker/.env.docker，至少填写 NEO4J_PASSWORD 与 MEMOS_CUBES_HOST_DIR
#   docker compose --env-file docker/.env.docker -f docker/docker-compose.yml up -d
#
# 这份文件承担两个角色，所以文件名必须两处一致：
#   1. --env-file  → 供 compose 自身插值（端口、镜像 tag、bind mount 路径等）
#   2. compose 的 env_file → 把应用配置（LLM/嵌入密钥、功能开关）注入容器
# 若把文件放在 docker/.env.docker 之外的位置，需同时设置
# OH_MEMOS_DOCKER_ENV_FILE=<相对 docker/ 的路径>，否则容器内只会拿到 compose
# 显式列出的那几个变量，应用侧会退回默认值（例如 embedder 退回 Ollama）。
#
# 这份文件与项目根 .env 是两套配置：根 .env 面向 Windows 本地启动，
# 里面的 localhost / G:\ 路径在 Linux 容器里没有意义。
#
# 千万不要把真实密钥提交进仓库。docker/.env.docker 已被 .gitignore 覆盖。
# ============================================================================

# ============================================================================
# 必填
# ============================================================================
# Neo4j 密码（必填；留空会让 docker compose config 直接失败）
# 不要把这里当作可直接运行的密码：复制后请填入本地随机长密码。
NEO4J_PASSWORD=

# 宿主机 cube 目录（bind mount 源）。必须用宿主机绝对路径。
# 宿主机上的 MCP server（npx oh-memos-mcp）要读写同一个目录，
# 所以这里不能改成 named volume。
#   Windows: G:/test/oh-memos/data/oh-memos_cubes
#   Linux:   /srv/oh-memos/cubes
MEMOS_CUBES_HOST_DIR=G:/test/oh-memos/data/oh-memos_cubes

# ============================================================================
# 镜像与端口
# ============================================================================
MEMOS_IMAGE=ghcr.io/lsg1103275794/oh-memos
MEMOS_TAG=latest

# 默认只监听回环地址。API 目前没有统一认证，改成 0.0.0.0 等于把全部记忆
# 读写接口暴露出去；需要远程访问请在前面加带 TLS 和认证的反向代理。
MEMOS_BIND_ADDRESS=127.0.0.1

# 若 Windows 侧 API 仍在跑（它占用 18000），这里必须换一个端口，例如 18100。
# Docker Desktop 在端口已被占用时可能不报错、直接跳过绑定，于是
# http://127.0.0.1:18000 回给你的是 Windows 那个 API，而不是容器 ——
# 容器自身健康但你测的根本不是它。用 `docker port oh-memos-api` 确认绑定是否生效。
MEMOS_HOST_PORT=18000
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
QDRANT_HTTP_HOST_PORT=16333
QDRANT_GRPC_HOST_PORT=6334

TZ=Asia/Shanghai

# ============================================================================
# Cube 与启动行为
# ============================================================================
MEMOS_DEFAULT_CUBE=dev_cube
# 留空 = 只注册默认 cube。all = 注册全部；也可写 cube1,cube2
MEMOS_STARTUP_CUBES=
MOS_ENABLE_DEFAULT_CUBE_CONFIG=true

MEMOS_TIMEOUT_TOOL=120.0
MEMOS_TIMEOUT_STARTUP=30.0
MEMOS_TIMEOUT_HEALTH=5.0
MEMOS_API_WAIT_MAX=60.0
MEMOS_ENABLE_DELETE=false
MEMOS_DEBUG=false

# 自动归档（防止 PROGRESS 记忆膨胀）
MEMOS_AUTO_ARCHIVE=true
MEMOS_ARCHIVE_TTL_DAYS=7
MEMOS_ARCHIVE_INTERVAL=3600
MEMOS_ARCHIVE_TYPES=PROGRESS

# 检索层：图扩散联想与层级过滤
MEMOS_SPREAD_ACTIVATION=true
MEMOS_SHOW_WORKING_MEMORY=false

# ============================================================================
# 记忆模式
# ============================================================================
# general_text = 仅向量检索（不需要 Neo4j）
# tree_text    = 知识图谱（Neo4j + Qdrant），功能完整
MOS_TEXT_MEM_TYPE=tree_text
MOS_ENABLE_REORGANIZE=true
MOS_REORGANIZE_TIMEOUT=1800
MOS_REORGANIZE_MIN_GROUP=10
ASYNC_MODE=sync
MOS_TOP_K=7

# ============================================================================
# 数据库
# ============================================================================
# 注意: NEO4J_URI / NEO4J_HTTP_URL / QDRANT_HOST / QDRANT_PORT 由 compose 固定为
# 容器网络地址（neo4j:7687、qdrant:6333），在这里写 localhost 不会生效。
NEO4J_USER=neo4j
NEO4J_DB_NAME=neo4j
NEO4J_BACKEND=neo4j-community
MOS_NEO4J_SHARED_DB=false
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g

# ============================================================================
# LLM（tree_text 模式必填，用于记忆提炼）
# ============================================================================
MOS_CHAT_MODEL_PROVIDER=openai
MOS_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
MOS_CHAT_TEMPERATURE=0.8
MOS_MAX_TOKENS=6000
MOS_TOP_P=0.9

MEMRADER_MODEL=gpt-4o-mini
MEMRADER_API_KEY=sk-your_openai_api_key
MEMRADER_API_BASE=https://api.openai.com/v1
MEMRADER_MAX_TOKENS=6000

# LLM 自动降级（可选）
MOS_CHAT_FALLBACK_ENABLED=false
MOS_CHAT_FALLBACK_BACKEND=openai
# 启用降级时以下三项必填 (留空 + ENABLED=true 会在启动时报配置错误)
MOS_CHAT_FALLBACK_MODEL=
MOS_CHAT_FALLBACK_API_KEY=
MOS_CHAT_FALLBACK_API_BASE=
MOS_CHAT_FALLBACK_MAX_RETRIES=3

# ============================================================================
# 嵌入模型（必填）
# ============================================================================
EMBEDDING_DIMENSION=1024
MOS_EMBEDDER_BACKEND=universal_api
MOS_EMBEDDER_PROVIDER=openai
MOS_EMBEDDER_MODEL=text-embedding-3-small
MOS_EMBEDDER_API_BASE=https://api.openai.com/v1
MOS_EMBEDDER_API_KEY=sk-your_embedding_api_key

# 嵌入降级到 Ollama（可选）
# 默认走宿主机 Ollama；若改用 --profile ollama 启动栈内 Ollama，
# 把地址换成 http://ollama:11434
MOS_EMBEDDER_FALLBACK_ENABLED=false
MOS_EMBEDDER_FALLBACK_BACKEND=ollama
MOS_EMBEDDER_FALLBACK_MODEL=nomic-embed-text:latest
MOS_EMBEDDER_FALLBACK_API_BASE=http://host.docker.internal:11434
MOS_EMBEDDER_FALLBACK_MAX_RETRIES=3
MOS_EMBEDDER_FALLBACK_DIMENSION_STRATEGY=error

# Ollama 作为主 LLM/嵌入后端时使用（栈内 profile: http://ollama:11434）
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_TAG=0.12.12
OLLAMA_HOST_PORT=11434

# ============================================================================
# 重排序（可选，提升检索质量）
# ============================================================================
MOS_RERANKER_BACKEND=universal_api
MOS_RERANKER_URL=https://api.siliconflow.cn/v1
MOS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MOS_RERANKER_API_KEY=
MOS_RERANKER_STRATEGY=single_turn

# ============================================================================
# 其他可选项
# ============================================================================
ENABLE_INTERNET=false
ENABLE_PREFERENCE_MEMORY=false
MEM_READER_BACKEND=simple_struct
MEM_READER_CHAT_CHUNK_TYPE=default
MEM_READER_CHAT_CHUNK_TOKEN_SIZE=1600
MEM_READER_CHAT_CHUNK_SESS_SIZE=10
MEM_READER_CHAT_CHUNK_OVERLAP=2
MOS_ENABLE_SCHEDULER=false
