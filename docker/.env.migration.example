# ============================================================================
# oh-memos 迁移期配置示例（Windows → Docker 全量迁移）
# ============================================================================
# 用法:
#   cp docker/.env.migration.example docker/.env.migration
#   # 填 NEO4J_PASSWORD（沿用 Windows 侧现有密码，dump/load 后凭据不变）
#   powershell -File scripts/migrate/migrate_win_to_docker.ps1 -Stage preflight
#
# 这份文件只在迁移期使用。迁移验证通过、Windows 侧清空后，日常运行请改用
# docker/.env.docker（基础栈，Neo4j 5.26.4）。
#
# 千万不要提交真实密钥。docker/.env.migration 已被 .gitignore 覆盖。
# ============================================================================

# ============================================================================
# 必填
# ============================================================================
# 让 compose 的 env_file 读到本文件（路径相对 docker/ 目录）
OH_MEMOS_DOCKER_ENV_FILE=./.env.migration

# 沿用 Windows Neo4j 的现有密码：dump/load 迁移的是数据库内容，
# 认证信息随 system 数据库保留，密码不会变。
NEO4J_PASSWORD=

# cube 的新宿主目录（项目目录之外，这样最后可以安全删除 data/oh-memos_cubes）。
# 宿主 MCP 的 MEMOS_CUBES_DIR 也要改成这个路径。
MEMOS_CUBES_HOST_DIR=D:/oh-memos-data/cubes

# 迁移工作目录：存放 Neo4j dump、Qdrant storage 副本、SQLite 副本、
# cube 归档与 hash manifest。必须在被删除的 Windows 源目录之外。
# 需要约 10 GB（Qdrant storage 9.1 GB + Neo4j dump + SQLite）。
OH_MEMOS_MIGRATION_DIR=D:/oh-memos-migration

# ============================================================================
# 源侧路径（迁移脚本读取，需与实际安装一致）
# ============================================================================
OH_MEMOS_SRC_NEO4J_HOME=D:/User/neo4j-community-5.15.0
OH_MEMOS_SRC_QDRANT_HOME=D:/User/Qdrant

# ============================================================================
# 镜像与端口
# ============================================================================
MEMOS_IMAGE=oh-memos
MEMOS_TAG=migration

MEMOS_BIND_ADDRESS=127.0.0.1

# 18100 而非 18000：Windows API 可能仍占用 18000，而 Docker Desktop 在端口
# 被占时会静默跳过绑定，导致你以为测的是容器、实际测的是 Windows API。
# 起完用 `docker port oh-memos-api` 核对。
MEMOS_HOST_PORT=18100

# 迁移期把数据库端口也错开，避免与尚未停止的 Windows 服务冲突。
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687
QDRANT_HTTP_HOST_PORT=16399
QDRANT_GRPC_HOST_PORT=16434

TZ=Asia/Shanghai

# ============================================================================
# 数据库（容器内地址由基础 compose 固定为服务名 neo4j / qdrant）
# ============================================================================
NEO4J_USER=neo4j
NEO4J_DB_NAME=neo4j
NEO4J_BACKEND=neo4j-community
MOS_NEO4J_SHARED_DB=false

# ============================================================================
# 迁移期关闭后台写任务
# ============================================================================
# 迁移与对账期间不允许归档/重组改写刚导入的图，否则计数无法与 manifest 对齐。
# 验证通过后再按需开启。
MEMOS_AUTO_ARCHIVE=false
MOS_ENABLE_REORGANIZE=false

# ============================================================================
# Cube 与启动行为
# ============================================================================
MEMOS_DEFAULT_CUBE=dev_cube
# 迁移期留空：只注册默认 cube，避免启动时批量注册干扰对账。
MEMOS_STARTUP_CUBES=
MOS_ENABLE_DEFAULT_CUBE_CONFIG=true

MEMOS_TIMEOUT_TOOL=120.0
MEMOS_TIMEOUT_STARTUP=30.0
MEMOS_TIMEOUT_HEALTH=5.0
MEMOS_API_WAIT_MAX=60.0
MEMOS_ENABLE_DELETE=false
MEMOS_DEBUG=false

# ============================================================================
# 记忆模式
# ============================================================================
MOS_TEXT_MEM_TYPE=tree_text
ASYNC_MODE=sync
MOS_TOP_K=7

# ============================================================================
# LLM / 嵌入 —— 必须与 Windows 侧完全一致
# ============================================================================
# 嵌入模型或维度不一致会让迁移后的向量无法与既有 collection 匹配，
# 检索结果会静默变差。建议直接照抄项目根 .env 的对应值。
MOS_CHAT_MODEL_PROVIDER=openai
MOS_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
MOS_CHAT_TEMPERATURE=0.8
MOS_MAX_TOKENS=6000
MOS_TOP_P=0.9

MEMRADER_MODEL=gpt-4o-mini
MEMRADER_API_KEY=sk-your_openai_api_key
MEMRADER_API_BASE=https://api.openai.com/v1
MEMRADER_MAX_TOKENS=6000
# 上游拒收 top_p（HTTP 400）时设为 none，请求里就不带 top_p。不设时为 0.95。
# MEMRADER_TOP_P=none

EMBEDDING_DIMENSION=1024
MOS_EMBEDDER_BACKEND=universal_api
MOS_EMBEDDER_PROVIDER=openai
MOS_EMBEDDER_MODEL=text-embedding-3-small
MOS_EMBEDDER_API_BASE=https://api.openai.com/v1
MOS_EMBEDDER_API_KEY=sk-your_embedding_api_key

# ============================================================================
# 其他
# ============================================================================
ENABLE_INTERNET=false
ENABLE_PREFERENCE_MEMORY=false
MEM_READER_BACKEND=simple_struct
MOS_ENABLE_SCHEDULER=false
