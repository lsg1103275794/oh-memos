# ============================================================================
# oh-memos Docker 配置示例 —— 直连宿主数据库模式（双侧并存）
# ============================================================================
# 用法:
#   cp docker/.env.host-db.example docker/.env.host-db
#   # 编辑 docker/.env.host-db：NEO4J_PASSWORD 必须填宿主 Neo4j 的现有密码
#   docker compose --env-file docker/.env.host-db \
#     -f docker/docker-compose.yml \
#     -f docker/docker-compose.host-db.yml up -d
#
# 与 .env.docker.example 的区别：这个模式**不启动**容器内的 Neo4j/Qdrant，
# 容器 API 直接读写 Windows 侧已在跑的那两个库。因此：
#   - 零数据迁移，两侧看到的是同一份图谱与向量
#   - 停掉任意一侧，另一侧照常可用
#
# 必须设 OH_MEMOS_DOCKER_ENV_FILE 指向本文件（compose 的 env_file 默认找
# .env.docker），否则应用配置进不了容器，embedder 会退回 Ollama 默认值。
#
# 千万不要把真实密钥提交进仓库。docker/.env.host-db 已被 .gitignore 覆盖。
# ============================================================================

# ============================================================================
# 必填
# ============================================================================
# 让 compose 的 env_file 读到本文件（路径相对 docker/ 目录）
OH_MEMOS_DOCKER_ENV_FILE=./.env.host-db

# 【本模式最易错的一项】必须是宿主 Neo4j 的**现有**密码。
# 这不是新建实例，密码由你已有的 Neo4j 决定；填错会让 API 起来但连不上图库。
NEO4J_PASSWORD=

# 宿主机 cube 目录（bind mount 源）。与 Windows 侧、宿主 MCP 共用同一目录。
MEMOS_CUBES_HOST_DIR=G:/test/oh-memos/data/oh-memos_cubes

# ============================================================================
# 镜像与端口
# ============================================================================
MEMOS_IMAGE=ghcr.io/lsg1103275794/oh-memos
MEMOS_TAG=latest

# API 无统一认证，默认只监听回环地址。改成 0.0.0.0 等于公开全部记忆读写接口。
MEMOS_BIND_ADDRESS=127.0.0.1

# 默认 18100：Windows 侧 API 占着 18000，两侧要并存必须错开。
# Docker Desktop 遇到端口被占会**静默跳过绑定**，此时 127.0.0.1:18000 回的是
# Windows 那个 API，容器虽 healthy 但你测的不是它。
# 起完务必 `docker port oh-memos-api` 核对。
MEMOS_HOST_PORT=18100

# 宿主 Qdrant 的实际端口（容器经 host.docker.internal 连它）。
# 注意这与容器网络内的 6333 是两回事。
QDRANT_HOST_DB_PORT=16333

TZ=Asia/Shanghai

# ============================================================================
# 数据库连接
# ============================================================================
# 地址由 docker-compose.host-db.yml 固定为 host.docker.internal，在这里写
# localhost 不会生效（compose 的 environment 优先级高于 env_file）。
# 以下三项需与宿主 Neo4j 实际配置一致：
NEO4J_USER=neo4j
NEO4J_DB_NAME=neo4j
NEO4J_BACKEND=neo4j-community
MOS_NEO4J_SHARED_DB=false

# ============================================================================
# 写入归属 —— 只能有一侧接收写入（本模式最重要的约束）
# ============================================================================
# 不只是后台任务：每次同步写入结束都会跑 WorkingMemory 清理
# （_cleanup_working_memory → remove_oldest_memory），按 updated_at 排序只留固定
# 条数、其余删除，且先删 Qdrant 向量再删 Neo4j 节点（非事务）。两侧同时写入时，
# 任一侧的清理都可能删掉对方刚写入的记忆。
#
# 因此：本模式约定**容器**接收全部写入（/memories、/chat、MCP save/canvas），
# Windows 侧只做只读查询，并改用 scripts/local/start_api_no_bg.bat 启动
# （该脚本还会让 Windows 侧的 POST /archive/run 返回 409，避免绕过约定）。
# 若要反过来让 Windows 侧写入，把下面两项都设为 false，并只从 Windows 侧发写请求。
MEMOS_AUTO_ARCHIVE=true
MEMOS_ARCHIVE_TTL_DAYS=7
MEMOS_ARCHIVE_INTERVAL=3600
MEMOS_ARCHIVE_TYPES=PROGRESS

# 检索层：图扩散联想与层级过滤
MEMOS_SPREAD_ACTIVATION=true
MEMOS_SHOW_WORKING_MEMORY=false
MOS_ENABLE_REORGANIZE=true
MOS_REORGANIZE_TIMEOUT=1800
MOS_REORGANIZE_MIN_GROUP=10

# ============================================================================
# Cube 与启动行为
# ============================================================================
MEMOS_DEFAULT_CUBE=dev_cube
# 留空 = 只注册默认 cube。all = 注册全部；也可写 cube1,cube2
MEMOS_STARTUP_CUBES=
MOS_ENABLE_DEFAULT_CUBE_CONFIG=true

MEMOS_TIMEOUT_TOOL=120.0
MEMOS_TIMEOUT_STARTUP=30.0
MEMOS_TIMEOUT_HEALTH=5.0
MEMOS_API_WAIT_MAX=60.0
MEMOS_ENABLE_DELETE=false
MEMOS_DEBUG=false

# ============================================================================
# 记忆模式
# ============================================================================
MOS_TEXT_MEM_TYPE=tree_text
ASYNC_MODE=sync
MOS_TOP_K=7

# ============================================================================
# LLM（tree_text 模式必填，用于记忆提炼）
# ============================================================================
# 建议直接抄项目根 .env 里那份能用的配置，保证两侧提炼/嵌入行为一致 ——
# 嵌入模型或维度不一致会让两侧写进同一 collection 的向量无法互相检索。
MOS_CHAT_MODEL_PROVIDER=openai
MOS_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
MOS_CHAT_TEMPERATURE=0.8
MOS_MAX_TOKENS=6000
MOS_TOP_P=0.9

MEMRADER_MODEL=gpt-4o-mini
MEMRADER_API_KEY=sk-your_openai_api_key
MEMRADER_API_BASE=https://api.openai.com/v1
MEMRADER_MAX_TOKENS=6000

# ============================================================================
# 嵌入模型（必填）—— 维度必须与宿主既有 collection 一致
# ============================================================================
EMBEDDING_DIMENSION=1024
MOS_EMBEDDER_BACKEND=universal_api
MOS_EMBEDDER_PROVIDER=openai
MOS_EMBEDDER_MODEL=text-embedding-3-small
MOS_EMBEDDER_API_BASE=https://api.openai.com/v1
MOS_EMBEDDER_API_KEY=sk-your_embedding_api_key

# ============================================================================
# 重排序（可选）
# ============================================================================
MOS_RERANKER_BACKEND=universal_api
MOS_RERANKER_URL=https://api.siliconflow.cn/v1
MOS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MOS_RERANKER_API_KEY=
MOS_RERANKER_STRATEGY=single_turn

# ============================================================================
# 其他可选项
# ============================================================================
ENABLE_INTERNET=false
ENABLE_PREFERENCE_MEMORY=false
MEM_READER_BACKEND=simple_struct
MEM_READER_CHAT_CHUNK_TYPE=default
MEM_READER_CHAT_CHUNK_TOKEN_SIZE=1600
MEM_READER_CHAT_CHUNK_SESS_SIZE=10
MEM_READER_CHAT_CHUNK_OVERLAP=2
MOS_ENABLE_SCHEDULER=false
