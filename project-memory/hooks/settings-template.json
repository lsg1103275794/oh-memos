{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy the hooks section into your ~/.claude/settings.json. Adjust paths to match your oh-memos install location.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_user_prompt.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_context_inject.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_block_sensitive.js",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "matcher must be the bare tool name. A value containing characters outside [A-Za-z0-9_-, |*] is treated as an unanchored regex against the TOOL NAME, so an expression like 'tool == \"Bash\" && ...' never matches and the hook silently never fires. Argument-level conditions belong in the script, or in the per-handler 'if' field.",
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_block_mkdir_memory.js",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "Blocks Claude Code's built-in file-based memory (~/.claude/projects/<proj>/memory/*.md) and points the agent at memos_save instead. Must cover Edit as well as Write, or the agent just switches tool.",
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_block_memory_write.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_log_commands.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_auto_save.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_notify_milestone.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_auto_save.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_pre_compact.js"
          },
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_auto_capture.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_auto_capture.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_auto_capture.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <MEMOS_PATH>/project-memory/hooks/node/oh_memos_session_start.js"
          }
        ]
      }
    ]
  }
}
