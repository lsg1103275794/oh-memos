# 行尾规范化 —— 防止 Windows 侧编辑把 CRLF 提交进 shell 脚本。
#
# 背景：scripts/bundle/*.sh 曾以 CRLF 提交，导致 Linux/macOS 上
# `bash install.sh` 直接报 $'\r': command not found，heredoc 的 EOF\r
# 也永远匹配不上 —— 整条 Unix bundle 安装路径不可用。

# 工作区一律 LF（下面列出的 Windows 脚本除外）。只写 `* text=auto` 时，Windows 上
# core.autocrlf=true 会把文件检出成 CRLF，而编辑器、Edit/Write 工具和脚本写回的是 LF，
# 同一个工作区里两种行尾混着，按字节比较的测试就会失败。
* text=auto eol=lf

# Unix 脚本必须 LF，否则解释器读到 \r 就崩
*.sh   text eol=lf
*.bash text eol=lf

# Windows 批处理必须 CRLF，否则 cmd.exe 对标签/多行块的处理会出问题
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# 二进制资产不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tgz  binary
*.jar  binary
*.dll  binary
*.exe  binary
*.so   binary
*.dylib binary

# Container build and runtime files execute on Linux; keep LF even on Windows.
.gitattributes text eol=lf
.git-blame-ignore-revs text eol=lf
.dockerignore text eol=lf
docker/Dockerfile text eol=lf
docker/*.sh text eol=lf
docker/*.yml text eol=lf
docker/*.yaml text eol=lf
docker/*.template text eol=lf
docker/*.txt text eol=lf
docker/.env.* text eol=lf
.github/workflows/*.yml text eol=lf
